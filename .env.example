# Server
PORT=5001
NODE_ENV=development
APP_URL=http://localhost:5001

# Database (use MongoDB Atlas on Vercel)
MONGODB_URI=mongodb://localhost:27017/petshop

# Security
JWT_SECRET=your_long_random_jwt_secret
SESSION_SECRET=your_long_random_session_secret

# AI Chatbot (add ONE of these)
GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=openrouter/free
# AI_TIMEOUT_MS=30000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# VNPay sandbox (optional — COD works without this)
VNP_TMNCODE=your_vnpay_tmn_code
VNP_HASHSECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5001/api/payments/vnpay/return
